@using BookStack.Shared

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Titel</th>
            <th>Autor</th>
            <th>ISBN</th>
            <th>Genre</th>
            <th>Bestand</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Books)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.ISBN</td>
                <td>@book.Genre</td>
                <td>@book.Stock</td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired]
    public List<BookDto> Books { get; set; } = new();
}
